# Cloudflare Pages headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: interest-cohort=()

/img/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned DMG downloads — filename changes each release, so cache forever
/dl/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

# …but the /dl/latest 302 must NOT inherit the year-long cache, or browsers
# would keep hopping to a deleted versioned DMG after the next release.
# (the ! detaches the /dl/* value — Pages appends duplicates, not overrides)
/dl/latest
  ! Cache-Control
  Cache-Control: public, max-age=300

# The curl|sh installer (also rewritten from /install) — plain text so
# browsers render it, short cache so a fixed script rolls out fast.
/install
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/style.css
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=86400
