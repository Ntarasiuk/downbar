# Swift / SwiftPM
.build/
.swiftpm/
Package.resolved

# Generated app bundle & Xcode project (built via scripts/xcodegen)
Downbar.app/
*.xcodeproj/
*.xcworkspace/
.xcbuild/

# Generated icon intermediates (regenerate via scripts/make-icon.sh)
Resources/*.iconset/

# macOS
.DS_Store

# App Store screenshot captures (scripts/screenshots.sh output) stay untracked,
# but the cropped README shots ship with the repo.
docs/screenshots/*.png
!docs/screenshots/panel.png
!docs/screenshots/settings-services.png
!docs/screenshots/settings-general.png

# Release artifacts (but ship the site's downloadable DMG with the Pages deploy)
*.dmg
!site/dl/*.dmg

# Wrangler local dev state
.wrangler/
